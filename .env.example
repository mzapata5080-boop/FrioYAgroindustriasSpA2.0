# Copia este ejemplo a .env solo para un entorno nuevo.
# Para conservar tu conexión actual, copia tu .env privado original a esta carpeta.
DATABASE_MODE=sqlite
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
FRONTEND_ORIGIN=http://localhost:5500
# Requerido al desplegar con DJANGO_DEBUG=false:
# DJANGO_SECRET_KEY=establece-una-clave-privada
# Para la base compartida (no ejecutar migrate):
# DATABASE_MODE=supabase
# DB_HOST=
# DB_PORT=5432
# DB_NAME=postgres
# DB_USER=
# DB_PASSWORD=
# DB_SSLMODE=require
